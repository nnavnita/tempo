rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ── users ──────────────────────────────────────────────────────────────────

    // Owner-only. The social build let any signed-in user read any profile so
    // friend search could work; this product has no cross-user reads at all,
    // so profiles are private again.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid);
      allow delete: if false;

      // ── tasks ──────────────────────────────────────────────────────────────

      match /tasks/{taskId} {
        allow read, write: if isOwner(uid);
      }

      // ── slots ──────────────────────────────────────────────────────────────
      //
      // Written by the client on re-plan and by the slip-detection Cloud
      // Function. The function uses the Admin SDK, which bypasses these rules,
      // so no service-account carve-out is needed here.

      match /slots/{slotId} {
        allow read, write: if isOwner(uid);
      }

      // ── plan state ─────────────────────────────────────────────────────────

      match /planState/{docId} {
        allow read, write: if isOwner(uid);
      }

      // ── busy cache ─────────────────────────────────────────────────────────
      //
      // A mirror of the user's Google Calendar free/busy. Same owner scope as
      // everything else: it is derived from their calendar and nobody else's.

      match /busyCache/{dayKey} {
        allow read, write: if isOwner(uid);
      }
    }

    // Anything not matched above is denied. Keeping this explicit so a new
    // collection cannot be reached by accident before its rules are written.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
