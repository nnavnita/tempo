rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Deterministic friendship doc ID: sorted([uid1, uid2]).join('_')
    function friendshipDocId(uid1, uid2) {
      return uid1 < uid2 ? uid1 + '_' + uid2 : uid2 + '_' + uid1;
    }

    function areFriends(uid1, uid2) {
      return exists(/databases/$(database)/documents/friendships/$(friendshipDocId(uid1, uid2)))
        && get(/databases/$(database)/documents/friendships/$(friendshipDocId(uid1, uid2))).data.status == 'accepted';
    }

    // ── users ──────────────────────────────────────────────────────────────────

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    // ── events ─────────────────────────────────────────────────────────────────

    match /events/{eventId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.ownerUid)
        || resource.data.visibility == 'everyone'
        || (resource.data.visibility == 'friends' && areFriends(request.auth.uid, resource.data.ownerUid))
        || request.auth.uid in resource.data.attendeeUids
      );
      allow create: if isSignedIn() && isOwner(request.resource.data.ownerUid);
      allow update: if isSignedIn() && isOwner(resource.data.ownerUid);
      allow delete: if isSignedIn() && isOwner(resource.data.ownerUid);
    }

    // ── busy_slots ─────────────────────────────────────────────────────────────

    match /busy_slots/{slotId} {
      // Any authenticated user can read busy slots (no sensitive detail exposed)
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner(request.resource.data.ownerUid);
      allow delete: if isSignedIn() && isOwner(resource.data.ownerUid);
    }

    // ── friendships ────────────────────────────────────────────────────────────

    match /friendships/{docId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.users;
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.requestedBy
        && request.auth.uid in request.resource.data.users
        && request.resource.data.status == 'pending';
      allow update: if isSignedIn() && request.auth.uid in resource.data.users;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.users;
    }

    // ── join_requests ──────────────────────────────────────────────────────────

    match /join_requests/{requestId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.requesterUid
        || request.auth.uid == resource.data.eventOwnerUid
      );
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.requesterUid
        && request.resource.data.status == 'pending';
      // Only the event owner can approve/deny
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.eventOwnerUid;
      allow delete: if false;
    }

    // ── invitations ────────────────────────────────────────────────────────────

    match /invitations/{invitationId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.inviteeUid
        || request.auth.uid == resource.data.eventOwnerUid
      );
      // Only the event owner can create invitations
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.eventOwnerUid;
      // Only the invitee can accept/reject
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.inviteeUid;
      allow delete: if false;
    }
  }
}
